		{
			"name": "Anonymous",
			"description": "Endpoints accessible without authentication (public/anonymous).",
			"item": [
				{
					"name": "Auth",
					"description": "Authentication endpoints for user and administrator login.",
					"item": [
						{
							"name": "Login - Administrator (Success)",
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"pm.test(\"Status code is 200\", function () {",
											"    pm.response.to.have.status(200);",
											"});",
											"",
											"pm.test(\"Response has success envelope and token\", function () {",
											"    var jsonData = pm.response.json();",
											"    pm.expect(jsonData.success).to.eql(true);",
											"    pm.expect(jsonData.status).to.eql(\"success\");",
											"    pm.expect(jsonData.data).to.have.property(\"accessToken\");",
											"    pm.expect(jsonData.data.tokenType).to.eql(\"Bearer\");",
											"    pm.expect(jsonData.data.user.email).to.eql(\"admin@sportsevents.com\");",
											"    ",
											"    // Automatically update collection auth_token variable",
											"    pm.collectionVariables.set(\"auth_token\", jsonData.data.accessToken);",
											"});"
										],
										"type": "text/javascript"
									}
								}
							],
							"request": {
								"auth": {
									"type": "noauth"
								},
								"method": "POST",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json",
										"type": "text"
									},
